# Backend API Base URL
# Set this to the URL of your Chamberly backend API
# Example: http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Organization ID
# Set this to your organization ID from the backend
# For development with seed data, use: 11111111-1111-1111-1111-111111111111
NEXT_PUBLIC_ORGANIZATION_ID=11111111-1111-1111-1111-111111111111
